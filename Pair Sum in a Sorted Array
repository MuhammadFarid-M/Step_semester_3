def pairSumSorted(nums, target):
    """
    Finds two distinct numbers in a sorted array that sum to target using Two Pointers.
    """
    left = 0
    right = len(nums) - 1

    while left < right:
        current_sum = nums[left] + nums[right]
        if current_sum == target:
            return (nums[left], nums[right])
        elif current_sum < target:
            left += 1
        else:
            right -= 1

    return "Not Found"


# --- Verification with Examples ---
print(pairSumSorted([-4, -1, 0, 3, 5, 9], 4))  # Output: (-1, 5)
print(pairSumSorted([1, 2, 3], 180))  # Output: "Not Found"
