def maxSumSubarray(sales, k):
    """
    Finds the maximum sum of any contiguous subarray of size k using Sliding Window.
    """
    n = len(sales)
    if k > n or k <= 0:
        return 0

    # Compute sum of the first window
    window_sum = sum(sales[:k])
    max_sum = window_sum

    # Slide the window across the array
    for i in range(k, n):
        # Add entry element, subtract exit element
        window_sum += sales[i] - sales[i - k]
        max_sum = max(max_sum, window_sum)

    return max_sum


# --- Verification with Example ---
sales = [2, 1, 5, 1, 3, 2]
k = 3
print(maxSumSubarray(sales, k))  # Output: 9
